// Listar toda as transações
GET http://localhost:3000/api/v1/transactions

###

// Gravar uma transação
POST http://localhost:3000/api/v1/transactions
content-type: application/json

{
    "usuario_id": 1,
    "categoria_id": 15,
    "tipo": "despesa",
    "valor": 300.00,
    "forma_pagamento": "pix",
    "data": "2026-09-10",
    "status": "pago",
    "descricao": "Pagto Van Pedro mes 09/26"
}

###

/*

tipo
---------------
RECEITA
DESPESA

status
---------------
PENDENTE
PAGO
CANCELADO

forma_pagamento
---------------
DINHEIRO
PIX
DEBITO
CREDITO
BOLETO
TRANSFERENCIA

*/

###
// Deletar uma transação
DELETE http://localhost:3000/api/v1/transactions/11

###

// Atualizar uma transação
PUT http://localhost:3000/api/v1/transactions/8
content-type: application/json

{
    "usuario_id": "1",
    "categoria_id": "16",
    "tipo": "DESPESA",
    "valor": "131.63",
    "forma_pagamento": "PIX",
    "data": "2026-11-09T03:00:00.000Z",
    "status": "PAGO",
    "descricao": "Pgto iptu apto mes 09/26"
}